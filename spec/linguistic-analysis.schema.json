{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsi.example/spec/linguistic-analysis.schema.json",
  "title": "WSI Linguistic Analysis Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "analysisId",
    "status",
    "source",
    "analyzer",
    "capabilities",
    "tokens",
    "dependencies",
    "findings"
  ],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "analysisId": {
      "type": "string",
      "pattern": "^wsi:linguistic-analysis/sha256-[a-f0-9]{64}$"
    },
    "status": { "enum": ["COMPLETE", "PARTIAL", "UNSUPPORTED"] },
    "source": { "$ref": "#/$defs/source" },
    "analyzer": { "$ref": "#/$defs/analyzer" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "annotationStatus": {
      "enum": ["RESOLVED", "UNRESOLVED", "UNSUPPORTED"]
    },
    "capabilityStatus": {
      "enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED"]
    },
    "stringAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/annotationStatus" },
        "value": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "RESOLVED" } }, "required": ["status"] },
          "then": { "required": ["value"] },
          "else": { "not": { "required": ["value"] } }
        }
      ]
    },
    "featuresAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/annotationStatus" },
        "value": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "scheme": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "RESOLVED" } }, "required": ["status"] },
          "then": { "required": ["value"] },
          "else": { "not": { "required": ["value"] } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "providerRevision", "resourceId", "contentSha256"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "providerRevision": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "language": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerId", "analyzerVersion", "contractVersion", "rulesetVersion"],
      "properties": {
        "analyzerId": { "type": "string", "pattern": "^wsi:linguistic-analyzer/[a-z0-9][a-z0-9-]*$" },
        "analyzerVersion": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "0.1.0" },
        "rulesetVersion": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TOKENIZATION",
        "NORMALIZATION",
        "SENTENCE_SEGMENTATION",
        "LEMMA",
        "POS",
        "MORPHOLOGY",
        "SYNTAX",
        "DISCOURSE_CUES"
      ],
      "properties": {
        "TOKENIZATION": { "$ref": "#/$defs/capabilityStatus" },
        "NORMALIZATION": { "$ref": "#/$defs/capabilityStatus" },
        "SENTENCE_SEGMENTATION": { "$ref": "#/$defs/capabilityStatus" },
        "LEMMA": { "$ref": "#/$defs/capabilityStatus" },
        "POS": { "$ref": "#/$defs/capabilityStatus" },
        "MORPHOLOGY": { "$ref": "#/$defs/capabilityStatus" },
        "SYNTAX": { "$ref": "#/$defs/capabilityStatus" },
        "DISCOURSE_CUES": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "span", "kind", "surface", "normalized", "lemma", "upos", "xpos", "features"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "unit"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 },
            "unit": { "const": "UNICODE_CODE_POINT" }
          }
        },
        "kind": { "enum": ["WORD", "NUMBER", "PUNCT", "SYMBOL", "OTHER"] },
        "surface": { "type": "string", "minLength": 1 },
        "normalized": { "$ref": "#/$defs/stringAnnotation" },
        "lemma": { "$ref": "#/$defs/stringAnnotation" },
        "upos": { "$ref": "#/$defs/stringAnnotation" },
        "xpos": { "$ref": "#/$defs/stringAnnotation" },
        "features": { "$ref": "#/$defs/featuresAnnotation" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependentTokenId", "headTokenId", "relation"],
      "properties": {
        "dependentTokenId": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
        "headTokenId": {
          "anyOf": [
            { "type": "string", "pattern": "^T[1-9][0-9]*$" },
            { "type": "null" }
          ]
        },
        "relation": { "$ref": "#/$defs/stringAnnotation" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "tokenId": { "type": "string", "pattern": "^T[1-9][0-9]*$" }
      }
    }
  }
}
