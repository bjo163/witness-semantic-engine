{
  "name": "witness-semantic-engine",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx src/cli.ts validate",
    "validate:golden": "tsx src/cli.ts validate data/golden-candidates/quran/037/030.json",
    "verify:source": "tsx src/cli.ts verify-source",
    "test": "tsx --test test/*.test.ts",
    "test:provider:live": "tsx --test test/provider-live.test.ts",
    "test:linguistics:live": "tsx --test test/linguistic-live.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run validate",
    "test:semantics": "tsx --test test/semantics.test.ts",
    "test:witness": "tsx --test test/witness.test.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
